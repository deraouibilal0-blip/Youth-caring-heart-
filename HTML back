<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Youth Caring Heart</title>

  <link rel="stylesheet" href="style.css">
</head>

<body>

  <!-- ================= HEADER ================= -->

  <header class="header">

    <a href="#home" class="logo">
      ❤️ Youth Caring Heart
    </a>

    <button
      class="mobile-menu"
      onclick="toggleMenu()"
      aria-label="Open menu">
      ☰
    </button>

    <nav class="nav" id="nav">

      <a href="#home">Home</a>
      <a href="#dashboard">Dashboard</a>
      <a href="#activities">Activities</a>
      <a href="#competitions">🏆 Competitions</a>
      <a href="#chat">Chat</a>
      <a href="#announcements">News</a>
      <a href="#profile">Profile</a>

    </nav>

    <div class="header-actions">

      <button
        class="theme-btn"
        onclick="toggleDark()"
        aria-label="Toggle dark mode">
        🌙
      </button>

      <button
        class="lang-btn"
        onclick="setLanguage('en')">
        EN
      </button>

      <button
        class="lang-btn"
        onclick="setLanguage('fr')">
        FR
      </button>

      <button
        class="lang-btn"
        onclick="setLanguage('ar')">
        AR
      </button>

    </div>

  </header>


  <main>

    <!-- ================= HOME ================= -->

    <section class="hero" id="home">

      <div class="hero-content">

        <div class="hero-label">
          BERKANE • MOROCCO
        </div>

        <h1>
          Young People.<br>
          <span>Positive Action.</span>
        </h1>

        <p>
          A simple youth platform for activities,
          competitions, ideas, communication and
          positive action.
        </p>

        <a
          href="#competitions"
          class="button">
          Explore Competitions
        </a>

      </div>

    </section>


    <!-- ================= DASHBOARD ================= -->

    <section
      class="section dashboard-section"
      id="dashboard">

      <div class="section-title">

        <div class="section-label">
          📊 MEMBER DASHBOARD
        </div>

        <h2>
          Everything important.
          In one place.
        </h2>

        <p class="muted">
          Designed to be quick and easy for students.
        </p>

      </div>


      <div class="dashboard-grid">

        <div class="dashboard-card">

          <div class="icon">🏆</div>

          <div class="number">
            2
          </div>

          <h3>
            Competitions
          </h3>

          <p class="muted">
            Currently available
          </p>

        </div>


        <div class="dashboard-card">

          <div class="icon">📅</div>

          <div class="number">
            5
          </div>

          <h3>
            Activities
          </h3>

          <p class="muted">
            Upcoming activities
          </p>

        </div>


        <div class="dashboard-card">

          <div class="icon">📢</div>

          <div class="number">
            3
          </div>

          <h3>
            Announcements
          </h3>

          <p class="muted">
            Latest news
          </p>

        </div>


        <div class="dashboard-card">

          <div class="icon">❤️</div>

          <div class="number">
            24
          </div>

          <h3>
            Members
          </h3>

          <p class="muted">
            Youth community
          </p>

        </div>

      </div>

    </section>


    <!-- ================= ANNOUNCEMENTS ================= -->

    <section
      class="section"
      id="announcements">

      <div class="section-title">

        <div class="section-label">
          📢 ANNOUNCEMENTS
        </div>

        <h2>
          What's happening?
        </h2>

        <p class="muted">
          Important news and opportunities.
        </p>

      </div>


      <div
        class="announcement-grid"
        id="announcementGrid">


        <article class="announcement">

          <div class="announcement-poster">
            🌱
          </div>

          <div class="announcement-body">

            <div class="announcement-date">
              NEW INITIATIVE
            </div>

            <h3>
              Green Berkane
            </h3>

            <p class="muted">
              A new environmental activity
              is coming soon.
            </p>

          </div>

        </article>


        <article class="announcement">

          <div class="announcement-poster">
            🏆
          </div>

          <div class="announcement-body">

            <div class="announcement-date">
              COMPETITION
            </div>

            <h3>
              Chess Championship
            </h3>

            <p class="muted">
              Registration is now open.
            </p>

          </div>

        </article>


        <article class="announcement">

          <div class="announcement-poster">
            📚
          </div>

          <div class="announcement-body">

            <div class="announcement-date">
              STUDENTS
            </div>

            <h3>
              Study-Friendly Activities
            </h3>

            <p class="muted">
              Activities are planned around
              students' schedules.
            </p>

          </div>

        </article>

      </div>

    </section>


    <!-- ================= COMPETITIONS ================= -->

    <section
      class="section competition-section"
      id="competitions">

      <div class="competition-inner">

        <div class="section-title">

          <div class="section-label">
            🏆 COMPETITIONS
          </div>

          <h2>
            Compete. Participate.
            Have fun.
          </h2>

          <p>
            Easy registration for young participants.
          </p>

        </div>


        <div class="competition-grid">


          <!-- FOOTBALL -->

          <article class="competition">

            <div class="competition-top">

              <div class="competition-icon">
                ⚽
              </div>

              <span class="badge">
                REGISTRATION OPEN
              </span>

            </div>

            <h3>
              YCH Football League
            </h3>

            <p class="muted">
              Team competition for young participants.
            </p>


            <div
              class="countdown"
              data-date="2026-09-01T18:00:00">

              <div class="time-box">
                <strong class="days">00</strong>
                <span>DAYS</span>
              </div>

              <div class="time-box">
                <strong class="hours">00</strong>
                <span>HOURS</span>
              </div>

              <div class="time-box">
                <strong class="minutes">00</strong>
                <span>MIN</span>
              </div>

              <div class="time-box">
                <strong class="seconds">00</strong>
                <span>SEC</span>
              </div>

            </div>


            <div class="competition-actions">

              <button
                class="small-button primary"
                onclick="joinCompetition('Football')">

                Join Competition

              </button>

            </div>

          </article>


          <!-- CHESS -->

          <article class="competition">

            <div class="competition-top">

              <div class="competition-icon">
                ♟️
              </div>

              <span class="badge">
                REGISTRATION OPEN
              </span>

            </div>

            <h3>
              YCH Chess Tournament
            </h3>

            <p class="muted">
              Individual chess tournament.
            </p>


            <div
              class="countdown"
              data-date="2026-09-05T18:00:00">

              <div class="time-box">
                <strong class="days">00</strong>
                <span>DAYS</span>
              </div>

              <div class="time-box">
                <strong class="hours">00</strong>
                <span>HOURS</span>
              </div>

              <div class="time-box">
                <strong class="minutes">00</strong>
                <span>MIN</span>
              </div>

              <div class="time-box">
                <strong class="seconds">00</strong>
                <span>SEC</span>
              </div>

            </div>


            <div class="competition-actions">

              <button
                class="small-button primary"
                onclick="joinCompetition('Chess')">

                Join Competition

              </button>

            </div>

          </article>

        </div>

      </div>

    </section>


    <!-- ================= ACTIVITIES ================= -->

    <section
      class="section"
      id="activities">

      <div class="section-title">

        <div class="section-label">
          📅 CALENDAR
        </div>

        <h2>
          Upcoming activities.
        </h2>

        <p class="muted">
          Short, useful and easy to follow.
        </p>

      </div>


      <div class="calendar">

        <div class="calendar-header">

          <strong>
            YCH Calendar
          </strong>

          <span>
            2026
          </span>

        </div>


        <div class="calendar-list">

          <div class="calendar-event">

            <div class="event-date">
              28<br>AUG
            </div>

            <div>

              <strong>
                🌱 Community Clean-Up
              </strong>

              <p class="muted">
                Berkane • 10:00
              </p>

            </div>

          </div>


          <div class="calendar-event">

            <div class="event-date">
              01<br>SEP
            </div>

            <div>

              <strong>
                ⚽ Football League
              </strong>

              <p class="muted">
                Registration deadline
              </p>

            </div>

          </div>


          <div class="calendar-event">

            <div class="event-date">
              05<br>SEP
            </div>

            <div>

              <strong>
                ♟️ Chess Tournament
              </strong>

              <p class="muted">
                Competition day
              </p>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- ================= CHAT ================= -->

    <section
      class="section chat-section"
      id="chat">

      <div class="section-title">

        <div class="section-label">
          💬 COMMUNITY CHAT
        </div>

        <h2>
          Talk with the community.
        </h2>

        <p class="muted">
          A simple demo community chat.
        </p>

      </div>


      <div class="chat-layout">


        <aside class="chat-sidebar">

          <h3>
            Channels
          </h3>

          <div class="channel active">
            💬 General
          </div>

          <div class="channel">
            🏆 Competitions
          </div>

          <div class="channel">
            🌱 Environment
          </div>

          <div class="channel">
            💡 Ideas
          </div>

        </aside>


        <div class="chat-main">

          <div class="chat-header">

            💬 General

            <span>
              24 members
            </span>

          </div>


          <div
            class="messages"
            id="chatMessages">

            <div class="message">

              <small>
                Youth Caring Heart
              </small>

              <div>
                Welcome to the community! ❤️
              </div>

            </div>


            <div class="message">

              <small>
                Admin
              </small>

              <div>
                Don't forget the upcoming activities.
              </div>

            </div>

          </div>


          <div class="chat-input">

            <input
              id="chatInput"
              type="text"
              placeholder="Write a message..."
              maxlength="300"
              onkeydown="if(event.key==='Enter') sendChat()">

            <button
              onclick="sendChat()">
              Send
            </button>

          </div>

        </div>

      </div>

    </section>


    <!-- ================= DOCUMENTS ================= -->

    <section class="section">

      <div class="section-title">

        <div class="section-label">
          📁 DOCUMENTS
        </div>

        <h2>
          Important files.
        </h2>

      </div>


      <div class="documents">

        <div class="document">

          <div class="document-icon">
            📄
          </div>

          <h3>
            Activity Program
          </h3>

          <p class="muted">
            Information for participants.
          </p>

        </div>


        <div class="document">

          <div class="document-icon">
            📋
          </div>

          <h3>
            Member Guide
          </h3>

          <p class="muted">
            Basic information for members.
          </p>

        </div>


        <div class="document">

          <div class="document-icon">
            📜
          </div>

          <h3>
            Competition Rules
          </h3>

          <p class="muted">
            Rules and participation information.
          </p>

        </div>

      </div>

    </section>


    <!-- ================= NOTIFICATIONS ================= -->

    <section class="section">

      <div class="section-title">

        <div class="section-label">
          🔔 NOTIFICATIONS
        </div>

        <h2>
          Don't miss anything.
        </h2>

      </div>


      <div class="notifications">

        <div class="notification">

          <div class="notification-icon">
            🏆
          </div>

          <div>

            <strong>
              Competition reminder
            </strong>

            <p class="muted">
              Football registration deadline
              is approaching.
            </p>

          </div>

        </div>


        <div class="notification">

          <div class="notification-icon">
            📢
          </div>

          <div>

            <strong>
              New announcement
            </strong>

            <p class="muted">
              A new Youth Caring Heart
              announcement was published.
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- ================= PROFILE ================= -->

    <section
      class="section"
      id="profile">

      <div class="section-title">

        <div class="section-label">
          👤 MEMBER PROFILE
        </div>

        <h2>
          Your participation.
        </h2>

      </div>


      <div class="profile">

        <div class="avatar">
          👤
        </div>

        <div>

          <h3>
            Member Name
          </h3>

          <p class="muted">
            Youth Caring Heart Member
          </p>

          <p>
            🏆 Competitions: 2
            &nbsp; • &nbsp;
            🤝 Activities: 5
          </p>

        </div>

      </div>

    </section>


    <!-- ================= ADMIN ================= -->

    <section
      class="section admin-section"
      id="admin">

      <div class="section-title">

        <div class="section-label">
          🔐 ADMIN PANEL
        </div>

        <h2>
          Manage the platform.
        </h2>

        <p>
          Prototype tools for creating announcements
          and competitions.
        </p>

      </div>


      <div class="admin-panel">


        <h3>
          📢 Create Announcement
        </h3>


        <div class="form-grid">


          <div class="field">

            <label for="announcementTitle">
              Title
            </label>

            <input
              id="announcementTitle"
              type="text"
              placeholder="Announcement title"
              maxlength="80">

          </div>


          <div class="field">

            <label for="announcementCategory">
              Category
            </label>

            <select id="announcementCategory">

              <option>
                News
              </option>

              <option>
                Competition
              </option>

              <option>
                Activity
              </option>

              <option>
                Important
              </option>

            </select>

          </div>


          <div class="field full">

            <label for="announcementText">
              Description
            </label>

            <textarea
              id="announcementText"
              placeholder="Write your announcement..."
              maxlength="500"></textarea>

          </div>

        </div>


        <div class="admin-actions">

          <button
            class="button"
            onclick="publishAnnouncement()">
            📢 Publish
          </button>

          <button
            class="theme-btn"
            onclick="clearAnnouncementForm()">
            Clear
          </button>

        </div>


        <hr>


        <h3>
          🏆 Create Competition
        </h3>


        <div class="form-grid">


          <div class="field">

            <label for="competitionName">
              Competition Name
            </label>

            <input
              id="competitionName"
              type="text"
              placeholder="Example: YCH Football League"
              maxlength="80">

          </div>


          <div class="field">

            <label for="competitionType">
              Type
            </label>

            <select id="competitionType">

              <option>
                ⚽ Football
              </option>

              <option>
                ♟️ Chess
              </option>

              <option>
                🏆 Other
              </option>

            </select>

          </div>


          <div class="field full">

            <label for="competitionDeadline">
              Registration Deadline
            </label>

            <input
              id="competitionDeadline"
              type="datetime-local">

          </div>

        </div>


        <div class="admin-actions">

          <button
            class="button"
            onclick="createCompetition()">

            🏆 Create Competition

          </button>

        </div>

      </div>

    </section>

  </main>


  <!-- ================= APPLICATION MODAL ================= -->

  <div
    class="application-overlay"
    id="applicationOverlay"
    aria-hidden="true">


    <div
      class="application-modal"
      role="dialog"
      aria-modal="true">


      <button
        class="close-application"
        onclick="closeApplication()"
        aria-label="Close">
        ✕
      </button>


      <div class="application-icon">
        🏆
      </div>


      <h2>
        Competition Application
      </h2>


      <p
        id="applicationCompetition"
        class="muted">
      </p>


      <form
        id="applicationForm"
        onsubmit="submitApplication(event)">


        <div class="application-field">

          <label for="appName">
            Full Name *
          </label>

          <input
            id="appName"
            type="text"
            required
            maxlength="80"
            autocomplete="name"
            placeholder="Your full name">

        </div>


        <div class="application-field">

          <label for="appEmail">
            Email *
          </label>

          <input
            id="appEmail"
            type="email"
            required
            maxlength="120"
            autocomplete="email"
            placeholder="your@email.com">

        </div>


        <div class="application-field">

          <label for="appPhone">
            Phone *
          </label>

          <input
            id="appPhone"
            type="tel"
            required
            maxlength="25"
            autocomplete="tel"
            placeholder="+212 ...">

        </div>


        <label class="application-check">

          <input
            id="appAgreement"
            type="checkbox"
            required>

          <span>
            I confirm that the information I provided
            is correct.
          </span>

        </label>


        <button
          type="submit"
          class="button application-submit">

          Submit Application

        </button>

      </form>


      <div
        class="application-success"
        id="applicationSuccess">

        <div>
          🎉
        </div>

        <h3>
          Application Received!
        </h3>

        <p class="muted">
          Your application has been saved
          in this browser for this prototype.
        </p>

        <button
          class="small-button primary"
          onclick="closeApplication()">

          Done

        </button>

      </div>

    </div>

  </div>


  <!-- ================= FOOTER ================= -->

  <footer>

    <div class="footer-logo">
      ❤️ Youth Caring Heart
    </div>

    <p>
      Youth • Community • Environment • Action
    </p>

    <small>
      © 2026 Youth Caring Heart — Berkane, Morocco
    </small>

  </footer>


  <!-- ================= JAVASCRIPT ================= -->

  <script src="script.js"></script>

</body>
</html>
