/* =====================================================
   YOUTH CARING HEART
   FINAL STYLE SHEET
===================================================== */


/* ================= ROOT ================= */

:root {

  --green: #173f2a;
  --green-dark: #0d2417;
  --green-light: #dcebd2;
  --lime: #a8d477;

  --background: #f5f7f2;
  --white: #ffffff;

  --text: #173f2a;
  --muted: #68736b;

  --border: #e1e6df;

  --danger: #d9534f;

  --shadow:
    0 12px 35px rgba(23,63,42,.08);

}


/* ================= RESET ================= */

* {

  margin: 0;
  padding: 0;
  box-sizing: border-box;

}


html {

  scroll-behavior: smooth;

}


body {

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  background:
    var(--background);

  color:
    var(--text);

  line-height: 1.6;

  min-height: 100vh;

}


body,
button,
input,
textarea,
select {

  font-family:
    Arial,
    Helvetica,
    sans-serif;

}


button,
input,
textarea,
select {

  font: inherit;

}


button {

  cursor: pointer;

}


a {

  text-decoration: none;

  color: inherit;

}


img {

  max-width: 100%;

  display: block;

}


/* ================= HEADER ================= */

.header {

  position: sticky;

  top: 0;

  z-index: 1000;

  min-height: 72px;

  padding:
    12px 5%;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 20px;

  background:
    rgba(255,255,255,.96);

  backdrop-filter:
    blur(12px);

  border-bottom:
    1px solid var(--border);

}


.logo {

  font-size: 20px;

  font-weight: 900;

  white-space: nowrap;

}


.nav {

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 18px;

}


.nav a {

  font-size: 13px;

  font-weight: 800;

  transition:
    .2s ease;

}


.nav a:hover {

  color:
    #6b9b4f;

}


.header-actions {

  display: flex;

  align-items: center;

  gap: 7px;

}


.lang-btn,
.theme-btn {

  border:
    1px solid #cdd8c9;

  background:
    var(--white);

  color:
    var(--green);

  padding:
    7px 10px;

  border-radius:
    20px;

  font-size:
    11px;

  font-weight:
    800;

  transition:
    .2s ease;

}


.lang-btn:hover,
.theme-btn:hover {

  background:
    var(--green-light);

}


.mobile-menu {

  display: none;

  border: none;

  background:
    var(--green);

  color:
    white;

  width: 42px;

  height: 42px;

  border-radius:
    12px;

  font-size:
    20px;

}


/* ================= HERO ================= */

.hero {

  min-height:
    650px;

  display:
    flex;

  align-items:
    center;

  color:
    white;

  background:

    radial-gradient(
      circle at 80% 20%,
      rgba(168,212,119,.28),
      transparent 30%
    ),

    linear-gradient(
      120deg,
      #102e1d,
      #173f2a 55%,
      #5d874c
    );

}


.hero-content {

  width:
    90%;

  max-width:
    1150px;

  margin:
    auto;

}


.hero-label {

  font-size:
    12px;

  font-weight:
    900;

  letter-spacing:
    2px;

}


.hero h1 {

  font-size:
    clamp(48px,8vw,88px);

  line-height:
    .98;

  margin:
    20px 0;

}


.hero h1 span {

  color:
    #b7db91;

}


.hero p {

  max-width:
    650px;

  font-size:
    18px;

  margin-bottom:
    30px;

}


/* ================= BUTTON ================= */

.button {

  display:
    inline-block;

  border:
    none;

  padding:
    14px 25px;

  border-radius:
    30px;

  background:
    var(--lime);

  color:
    #102518;

  font-weight:
    900;

  transition:
    .25s ease;

}


.button:hover {

  transform:
    translateY(-3px);

  box-shadow:
    0 10px 25px
    rgba(168,212,119,.25);

}


/* ================= SECTIONS ================= */

.section {

  width:
    100%;

  max-width:
    1200px;

  margin:
    auto;

  padding:
    85px 5%;

}


.section-title {

  max-width:
    720px;

  margin-bottom:
    45px;

}


.section-label {

  font-size:
    12px;

  font-weight:
    900;

  letter-spacing:
    2px;

}


.section-title h2 {

  font-size:
    clamp(35px,5vw,55px);

  line-height:
    1.05;

  margin:
    14px 0;

}


.muted {

  color:
    var(--muted);

}


/* ================= DASHBOARD ================= */

.dashboard-section {

  background:
    #eef3e9;

  max-width:
    none;

}


.dashboard-section
.section-title,
.dashboard-grid {

  max-width:
    1100px;

  margin-left:
    auto;

  margin-right:
    auto;

}


.dashboard-grid {

  display:
    grid;

  grid-template-columns:
    repeat(4,1fr);

  gap:
    18px;

}


.dashboard-card {

  background:
    var(--white);

  border:
    1px solid var(--border);

  border-radius:
    20px;

  padding:
    22px;

  box-shadow:
    var(--shadow);

  transition:
    .25s ease;

}


.dashboard-card:hover {

  transform:
    translateY(-5px);

}


.dashboard-card .icon {

  font-size:
    30px;

}


.dashboard-card h3 {

  margin:
    8px 0 5px;

}


.number {

  font-size:
    30px;

  font-weight:
    900;

}


/* ================= ANNOUNCEMENTS ================= */

.announcement-grid {

  display:
    grid;

  grid-template-columns:
    repeat(3,1fr);

  gap:
    20px;

}


.announcement {

  background:
    var(--white);

  border:
    1px solid var(--border);

  border-radius:
    20px;

  overflow:
    hidden;

  box-shadow:
    var(--shadow);

  transition:
    .25s ease;

}


.announcement:hover {

  transform:
    translateY(-5px);

}


.announcement-poster {

  height:
    170px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  font-size:
    58px;

  color:
    white;

  background:

    linear-gradient(
      135deg,
      var(--green),
      #6d9858
    );

}


.announcement-body {

  padding:
    20px;

}


.announcement-date {

  font-size:
    11px;

  font-weight:
    900;

  color:
    #6b9b4f;

  letter-spacing:
    1px;

}


.announcement h3 {

  margin:
    8px 0;

}


/* ================= COMPETITIONS ================= */

.competition-section {

  max-width:
    none;

  background:
    var(--green);

  color:
    white;

}


.competition-inner {

  max-width:
    1100px;

  margin:
    auto;

}


.competition-grid {

  display:
    grid;

  grid-template-columns:
    repeat(2,1fr);

  gap:
    22px;

}


.competition {

  background:
    white;

  color:
    var(--green);

  padding:
    25px;

  border-radius:
    22px;

  box-shadow:
    var(--shadow);

}


.competition-top {

  display:
    flex;

  align-items:
    flex-start;

  justify-content:
    space-between;

  gap:
    10px;

}


.competition-icon {

  font-size:
    40px;

}


.badge {

  display:
    inline-block;

  padding:
    6px 11px;

  border-radius:
    20px;

  background:
    var(--green-light);

  font-size:
    11px;

  font-weight:
    900;

}


.competition h3 {

  font-size:
    25px;

  margin:
    12px 0 5px;

}


/* ================= COUNTDOWN ================= */

.countdown {

  display:
    grid;

  grid-template-columns:
    repeat(4,1fr);

  gap:
    8px;

  margin:
    20px 0;

}


.time-box {

  background:
    var(--green);

  color:
    white;

  border-radius:
    12px;

  text-align:
    center;

  padding:
    10px 5px;

}


.time-box strong {

  display:
    block;

  font-size:
    22px;

}


.time-box span {

  display:
    block;

  font-size:
    9px;

  opacity:
    .7;

}


.competition-actions {

  display:
    flex;

  gap:
    10px;

  margin-top:
    15px;

}


.small-button {

  border:
    none;

  background:
    var(--green-light);

  color:
    var(--green);

  padding:
    10px 16px;

  border-radius:
    20px;

  font-weight:
    800;

  transition:
    .2s ease;

}


.small-button:hover {

  transform:
    translateY(-2px);

}


.small-button.primary {

  background:
    var(--lime);

}


/* ================= CALENDAR ================= */

.calendar {

  background:
    white;

  border:
    1px solid var(--border);

  border-radius:
    20px;

  overflow:
    hidden;

  box-shadow:
    var(--shadow);

}


.calendar-header {

  padding:
    18px 22px;

  background:
    var(--green);

  color:
    white;

  display:
    flex;

  justify-content:
    space-between;

}


.calendar-list {

  padding:
    10px 20px;

}


.calendar-event {

  display:
    flex;

  align-items:
    center;

  gap:
    18px;

  padding:
    17px 5px;

  border-bottom:
    1px solid #e8ece5;

}


.calendar-event:last-child {

  border-bottom:
    none;

}


.event-date {

  min-width:
    65px;

  text-align:
    center;

  background:
    var(--green-light);

  border-radius:
    12px;

  padding:
    8px;

  font-weight:
    900;

}


/* ================= CHAT ================= */

.chat-section {

  max-width:
    none;

  background:
    #eef3e9;

}


.chat-section
.section-title,
.chat-layout {

  max-width:
    1100px;

  margin-left:
    auto;

  margin-right:
    auto;

}


.chat-layout {

  display:
    grid;

  grid-template-columns:
    210px 1fr;

  min-height:
    500px;

  background:
    white;

  border:
    1px solid var(--border);

  border-radius:
    22px;

  overflow:
    hidden;

  box-shadow:
    var(--shadow);

}


.chat-sidebar {

  background:
    var(--green);

  color:
    white;

  padding:
    22px;

}


.chat-sidebar h3 {

  margin-bottom:
    20px;

}


.channel {

  padding:
    11px;

  border-radius:
    10px;

  margin-bottom:
    5px;

  cursor:
    pointer;

  transition:
    .2s ease;

}


.channel:hover,
.channel.active {

  background:
    rgba(255,255,255,.12);

}


.chat-main {

  display:
    flex;

  flex-direction:
    column;

  min-width:
    0;

}


.chat-header {

  padding:
    18px 22px;

  border-bottom:
    1px solid var(--border);

  font-weight:
    900;

}


.chat-header span {

  float:
    right;

  font-size:
    12px;

  font-weight:
    500;

  opacity:
    .6;

}


.messages {

  flex:
    1;

  padding:
    22px;

  overflow:
    auto;

  min-height:
    320px;

}


.message {

  max-width:
    70%;

  background:
    #eef3e9;

  padding:
    12px 15px;

  border-radius:
    15px;

  margin-bottom:
    12px;

}


.message.mine {

  margin-left:
    auto;

  background:
    var(--green-light);

}


.message small {

  display:
    block;

  font-weight:
    900;

  margin-bottom:
    3px;

}


.chat-input {

  display:
    flex;

  gap:
    10px;

  padding:
    15px;

  border-top:
    1px solid var(--border);

}


.chat-input input {

  flex:
    1;

  min-width:
    0;

  border:
    1px solid var(--border);

  border-radius:
    12px;

  padding:
    12px;

  outline:
    none;

}


.chat-input input:focus {

  border-color:
    var(--lime);

}


.chat-input button {

  border:
    none;

  background:
    var(--lime);

  color:
    #102518;

  padding:
    12px 18px;

  border-radius:
    12px;

  font-weight:
    900;

}


/* ================= DOCUMENTS ================= */

.documents {

  display:
    grid;

  grid-template-columns:
    repeat(3,1fr);

  gap:
    18px;

}


.document {

  background:
    white;

  border:
    1px solid var(--border);

  border-radius:
    18px;

  padding:
    22px;

  box-shadow:
    var(--shadow);

}


.document-icon {

  font-size:
    32px;

  margin-bottom:
    8px;

}


/* ================= NOTIFICATIONS ================= */

.notification {

  display:
    flex;

  align-items:
    flex-start;

  gap:
    15px;

  padding:
    17px;

  background:
    white;

  border:
    1px solid var(--border);

  border-radius:
    15px;

  margin-bottom:
    10px;

}


.notification-icon {

  font-size:
    25px;

}


/* ================= PROFILE ================= */

.profile {

  background:
    white;

  border:
    1px solid var(--border);

  border-radius:
    22px;

  padding:
    28px;

  display:
    flex;

  align-items:
    center;

  gap:
    20px;

  box-shadow:
    var(--shadow);

}


.avatar {

  width:
    70px;

  height:
    70px;

  flex-shrink:
    0;

  border-radius:
    50%;

  background:
    var(--green-light);

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  font-size:
    30px;

}


/* ================= ADMIN ================= */

.admin-section {

  max-width:
    none;

  background:
    var(--green);

  color:
    white;

}


.admin-section
.section-title,
.admin-panel {

  max-width:
    900px;

  margin-left:
    auto;

  margin-right:
    auto;

}


.admin-panel {

  background:
    white;

  color:
    var(--green);

  border-radius:
    22px;

  padding:
    25px;

  box-shadow:
    var(--shadow);

}


.form-grid {

  display:
    grid;

  grid-template-columns:
    1fr 1fr;

  gap:
    15px;

  margin-top:
    18px;

}


.field {

  display:
    flex;

  flex-direction:
    column;

  gap:
    6px;

}


.field.full {

  grid-column:
    1 / -1;

}


.field label {

  font-size:
    13px;

  font-weight:
    800;

}


.field input,
.field textarea,
.field select {

  width:
    100%;

  border:
    1px solid var(--border);

  border-radius:
    10px;

  padding:
    12px;

  outline:
    none;

  background:
    white;

  color:
    var(--text);

}


.field input:focus,
.field textarea:focus,
.field select:focus {

  border-color:
    var(--lime);

}


.field textarea {

  min-height:
    100px;

  resize:
    vertical;

}


.admin-actions {

  display:
    flex;

  flex-wrap:
    wrap;

  gap:
    10px;

  margin-top:
    18px;

}


.admin-panel hr {

  margin:
    30px 0;

  border:
    none;

  border-top:
    1px solid var(--border);

}


/* ================= APPLICATION MODAL ================= */

.application-overlay {

  position:
    fixed;

  inset:
    0;

  z-index:
    3000;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  padding:
    20px;

  background:
    rgba(5,20,11,.72);

  backdrop-filter:
    blur(5px);

  opacity:
    0;

  visibility:
    hidden;

  transition:
    .25s ease;

}


.application-overlay.active {

  opacity:
    1;

  visibility:
    visible;

}


.application-modal {

  position:
    relative;

  width:
    100%;

  max-width:
    500px;

  max-height:
    90vh;

  overflow:
    auto;

  background:
    white;

  color:
    var(--green);

  border-radius:
    25px;

  padding:
    30px;

  box-shadow:
    0 25px 70px
    rgba(0,0,0,.25);

  transform:
    translateY(15px);

  transition:
    .25s ease;

}


.application-overlay.active
.application-modal {

  transform:
    translateY(0);

}


.close-application {

  position:
    absolute;

  top:
    15px;

  right:
    15px;

  width:
    35px;

  height:
    35px;

  border:
    none;

  border-radius:
    50%;

  background:
    #eef3e9;

  color:
    var(--green);

}


.application-icon {

  font-size:
    42px;

  margin-bottom:
    8px;

}


.application-modal h2 {

  margin-bottom:
    5px;

}


.application-field {

  margin-top:
    17px;

}


.application-field label {

  display:
    block;

  font-size:
    13px;

  font-weight:
    800;

  margin-bottom:
    6px;

}


.application-field input {

  width:
    100%;

  border:
    1px solid var(--border);

  border-radius:
    10px;

  padding:
    12px;

  outline:
    none;

}


.application-field input:focus {

  border-color:
    var(--lime);

}


.application-check {

  display:
    flex;

  align-items:
    flex-start;

  gap:
    8px;

  margin:
    18px 0;

  font-size:
    12px;

}


.application-check input {

  margin-top:
    4px;

}


.application-submit {

  width:
    100%;

}


.application-success {

  display:
    none;

  text-align:
    center;

  padding:
    25px 0 5px;

}


.application-success > div {

  font-size:
    55px;

  margin-bottom:
    10px;

}


/* ================= FOOTER ================= */

footer {

  background:
    var(--green-dark);

  color:
    white;

  text-align:
    center;

  padding:
    55px 20px;

}


.footer-logo {

  font-size:
    20px;

  font-weight:
    900;

  margin-bottom:
    8px;

}


/* ================= DARK MODE ================= */

body.dark {

  --background:
    #101812;

  --white:
    #18231c;

  --text:
    #edf6ed;

  --muted:
    #aeb9b0;

  --border:
    #2b3a30;

}


body.dark {

  background:
    var(--background);

  color:
    var(--text);

}


body.dark .header {

  background:
    rgba(16,24,18,.96);

}


body.dark .calendar,
body.dark .document,
body.dark .profile,
body.dark .notification,
body.dark .dashboard-card,
body.dark .announcement,
body.dark .admin-panel {

  background:
    var(--white);

  color:
    var(--text);

}


body.dark .theme-btn,
body.dark .lang-btn {

  background:
    var(--white);

  color:
    var(--text);

  border-color:
    var(--border);

}


body.dark .calendar {

  border-color:
    var(--border);

}


body.dark .calendar-event {

  border-color:
    var(--border);

}


body.dark .field input,
body.dark .field textarea,
body.dark .field select,
body.dark .application-field input {

  background:
    #101812;

  color:
    white;

  border-color:
    var(--border);

}


body.dark .chat-layout {

  background:
    var(--white);

}


body.dark .chat-header {

  border-color:
    var(--border);

}


body.dark .chat-input {

  border-color:
    var(--border);

}


body.dark .chat-input input {

  background:
    #101812;

  color:
    white;

}


body.dark .application-modal {

  background:
    #18231c;

  color:
    white;

}


body.dark .close-application {

  background:
    #2b3a30;

  color:
    white;

}


/* ================= MOBILE ================= */

@media (max-width: 1000px) {

  .nav {

    gap:
      12px;

  }

  .nav a {

    font-size:
      12px;

  }

  .dashboard-grid {

    grid-template-columns:
      repeat(2,1fr);

  }

}


@media (max-width: 800px) {

  .header {

    position:
      sticky;

  }


  .mobile-menu {

    display:
      block;

  }


  .nav {

    display:
      none;

    position:
      absolute;

    top:
      72px;

    left:
      0;

    width:
      100%;

    padding:
      20px;

    background:
      white;

    border-bottom:
      1px solid var(--border);

    flex-direction:
      column;

    align-items:
      stretch;

    gap:
      5px;

  }


  .nav.mobile-open {

    display:
      flex;

  }


  .nav a {

    padding:
      12px;

    border-radius:
      10px;

  }


  .nav a:hover {

    background:
      var(--green-light);

  }


  .competition-grid {

    grid-template-columns:
      1fr;

  }


  .announcement-grid {

    grid-template-columns:
      1fr;

  }


  .documents {

    grid-template-columns:
      1fr;

  }


  .chat-layout {

    grid-template-columns:
      1fr;

  }


  .chat-sidebar {

    display:
      none;

  }

}


@media (max-width: 600px) {

  .header {

    padding:
      10px 4%;

  }


  .logo {

    font-size:
      16px;

  }


  .header-actions {

    gap:
      4px;

  }


  .lang-btn {

    display:
      none;

  }


  .hero {

    min-height:
      570px;

  }


  .hero h1 {

    font-size:
      48px;

  }


  .hero p {

    font-size:
      16px;

  }


  .section {

    padding:
      65px 5%;

  }


  .dashboard-grid {

    grid-template-columns:
      1fr 1fr;

    gap:
      12px;

  }


  .dashboard-card {

    padding:
      17px;

  }


  .number {

    font-size:
      25px;

  }


  .countdown {

    gap:
      5px;

  }


  .time-box {

    padding:
      8px 3px;

  }


  .time-box strong {

    font-size:
      18px;

  }


  .calendar-event {

    align-items:
      flex-start;

  }


  .form-grid {

    grid-template-columns:
      1fr;

  }


  .field.full {

    grid-column:
      auto;

  }


  .profile {

    align-items:
      flex-start;

  }


  .application-modal {

    padding:
      25px 20px;

  }


  .message {

    max-width:
      85%;

  }


  .chat-input button {

    padding:
      10px 14px;

  }

}


/* ================= ACCESSIBILITY ================= */

button:focus-visible,
a:focus-visible,
input:focus-visible,
textarea:focus-visible,
select:focus-visible {

  outline:
    3px solid
    rgba(168,212,119,.7);

  outline-offset:
    2px;

}
