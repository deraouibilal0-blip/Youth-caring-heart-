/* ================= AI ASSISTANT ================= */

.ai-button {

  position: fixed;

  right: 22px;
  bottom: 22px;

  width: 60px;
  height: 60px;

  border: none;

  border-radius: 50%;

  background: #a8d477;

  font-size: 27px;

  box-shadow:
    0 10px 30px rgba(0,0,0,.18);

  z-index: 2000;

  transition: .25s ease;
}

.ai-button:hover {

  transform: scale(1.08);

}

.ai-panel {

  position: fixed;

  right: 22px;
  bottom: 95px;

  width: 360px;
  max-width: calc(100vw - 30px);

  height: 500px;

  background: white;

  border-radius: 22px;

  box-shadow:
    0 20px 60px rgba(0,0,0,.2);

  overflow: hidden;

  display: flex;

  flex-direction: column;

  z-index: 2001;

  opacity: 0;

  visibility: hidden;

  transform: translateY(15px);

  transition: .25s ease;

}

.ai-panel.active {

  opacity: 1;

  visibility: visible;

  transform: translateY(0);

}

.ai-header {

  background: #173f2a;

  color: white;

  padding: 17px;

  display: flex;

  justify-content: space-between;

  align-items: center;

}

.ai-header strong {

  display: block;

}

.ai-header small {

  opacity: .7;

}

.ai-header button {

  border: none;

  background: transparent;

  color: white;

  font-size: 25px;

}

.ai-messages {

  flex: 1;

  overflow-y: auto;

  padding: 17px;

  background: #f5f7f2;

}

.ai-message {

  max-width: 85%;

  padding: 12px 14px;

  border-radius: 15px;

  margin-bottom: 10px;

  font-size: 14px;

}

.ai-message.bot {

  background: white;

}

.ai-message.user {

  margin-left: auto;

  background: #dcebd2;

}

.ai-input {

  display: flex;

  gap: 8px;

  padding: 12px;

  border-top: 1px solid #e1e6df;

}

.ai-input input {

  flex: 1;

  min-width: 0;

  border: 1px solid #e1e6df;

  border-radius: 12px;

  padding: 11px;

  outline: none;

}

.ai-input button {

  border: none;

  background: #a8d477;

  color: #173f2a;

  padding: 10px 15px;

  border-radius: 12px;

  font-weight: 900;

}


/* Mobile */

@media(max-width:600px) {

  .ai-panel {

    right: 15px;
    bottom: 85px;

    width: calc(100vw - 30px);

    height: 70vh;

  }

  .ai-button {

    right: 15px;
    bottom: 15px;

  }

}
